NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Rejestracja: konta zakłada się z linku zaproszenia (Ustawienia → Zespół).
# Pierwsze konto administratora albo otwarta rejestracja (lokalnie `npm run dev` jest zawsze otwarta):
# NEXT_PUBLIC_OPEN_SIGNUP=1

# Lokalny Qwen przez Ollamę. Tylko loopback, tylko na Macu właściciela. Nie ustawiaj na Vercel.
# LOCAL_LLM_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=qwen3.5:4b

# Szkice dla obu handlowców na Vercel. Jeden klucz OpenCode Zen, jedno saldo.
# Na Vercel: Settings → Environment Variables. Nie commituj klucza.
# HOSTED_LLM_API_KEY=
# HOSTED_LLM_URL=https://opencode.ai/zen/v1/chat/completions
# HOSTED_LLM_MODEL=deepseek-v4-flash
# Qwen na Zenie idzie inną trasą:
# HOSTED_LLM_URL=https://opencode.ai/zen/v1/messages
# HOSTED_LLM_MODEL=qwen3.5-plus

# Discovery z rozmowy (transkrypt ze Spinach → pola Discovery) przez Claude API.
# Klucz: console.anthropic.com → API Keys. Tylko serwer — nie trafia do przeglądarki. Nie commituj klucza.
# Bez klucza działa ścieżka „Przez Claude”: kopiujesz polecenie do claude.ai / Cowork i wklejasz odpowiedź.
# Zwykły klucz API (sk-ant-api…). Token z `claude setup-token` (sk-ant-oat…) tu nie działa — to dostęp do Claude Code w subskrypcji.
# Plan Max albo Team ma miesięczne kredyty API: claude.ai → Ustawienia → Billing → API credits → połącz z organizacją w Console.
# ANTHROPIC_API_KEY=
# Tylko gdy klucz nie jest przypisany do workspace'u (Console → Workspaces → ID):
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Model domyślny. Taniej: claude-haiku-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high — wyżej: dłużej, drożej, dokładniej
# ANTHROPIC_EFFORT=low
# Kto może używać płatnego AI (Claude i Zen): adresy albo domeny, tylko z potwierdzonym mailem.
# Na produkcji (Vercel, next start) OBOWIĄZKOWE — bez listy AI jest wyłączone. Lokalnie puste = każdy zalogowany.
# Limity na osobę: 30 odczytów rozmów i 60 szkiców na godzinę.
# AI_ALLOWED_EMAILS=kuba@firma.pl,@lutra.pl
# Świadomie otwórz AI dla każdego zalogowanego na produkcji (niezalecane):
# AI_OPEN_TO_ALL=1
# Tylko tryb demo bez Supabase, na własnym komputerze: pozwól na klucz bez logowania.
# AI_ALLOW_WITHOUT_LOGIN=1

# Smoke test skilla dla partnera „Test” (dopisuje przykładowe dane). Tylko na środowisku testowym.
# NEXT_PUBLIC_SKILL_SMOKE=1
